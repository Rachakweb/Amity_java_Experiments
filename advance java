5. Session Bean Management

A stateful session bean storing user data.

Stateful Session Bean

import javax.ejb.Stateful;

@Stateful
public class UserSessionBean {
    private String username;

    public void setUsername(String username) {
        this.username = username;
    }

    public String getUsername() {
        return username;
    }
}

Client

import javax.naming.Context;
import javax.naming.InitialContext;

public class SessionBeanClient {
    public static void main(String[] args) throws Exception {
        Context context = new InitialContext();
        UserSessionBean userBean = (UserSessionBean) context.lookup("java:global/MyApp/UserSessionBean");
        userBean.setUsername("JohnDoe");
        System.out.println("Username: " + userBean.getUsername());
    }
}


